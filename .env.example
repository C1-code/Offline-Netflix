# Copy to .env and edit — used by docker compose on THIS machine.
# Absolute path to your media library on this machine (host side of the mount;
# inside the container it appears at /media).
MEDIA_PATH=/home/youruser/Media

# Optional: free API key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Optional: host port for the web UI (default 8420)
#PORT=8420
