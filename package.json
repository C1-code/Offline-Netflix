{
  "name": "offline-netflix",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Netflix-style frontend for your local media library",
  "license": "MIT",
  "scripts": {
    "start": "node server.js",
    "scan": "node tools/scan.mjs",
    "subs": "node tools/subs-all.mjs",
    "subs:regen": "node tools/subs-regen.mjs",
    "subs:prune": "node tools/prune-subs.mjs",
    "rename:dry": "node tools/rename.mjs --dry-run",
    "rename:apply": "node tools/rename.mjs --apply",
    "tmdb:sync": "node tools/tmdb-sync.mjs",
    "chars": "node tools/characters.mjs",
    "chars:sync": "node tools/characters.mjs",
    "chars:list": "node tools/characters.mjs --list",
    "thumbs": "node tools/thumbs.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "express": "^4.21.2"
  }
}
